source("C:/Users/somor/OneDrive/Escritorio/ProyR/graficos3.R")
# Cargar el DataFrame desde el archivo CSV
dfAccidentesL <- read.csv("C:/Users/somor/OneDrive/Escritorio/ProyR/datosUnidos.csv", header = TRUE, sep = ";")
# Convertir NaN a NA en la columna HUMEDAD_RELATIVA
dfAccidentesL$HUMEDAD_RELATIVA[is.nan(dfAccidentesL$HUMEDAD_RELATIVA)] <- NA
# Utilizar dplyr para agrupar por MES y calcular la media de HUMEDAD_RELATIVA
resultados <- dfAccidentesL %>%
group_by(MES) %>%
summarise(Media_Humedad = mean(HUMEDAD_RELATIVA, na.rm = TRUE))
# Mostrar los resultados
print(resultados)
# Crear un gráfico de líneas
ggplot(resultados_viento, aes(x = Suma_VIENTO, y = Num_Accidentes, group = MES, color = MES)) +
geom_line(size = 3) +
geom_point(size = 3) +
labs(title = "Relación entre VIENTO y Número de accidentes por MES",
x = "Suma de VIENTO",
y = "Número de accidentes") +
scale_color_manual(values = rep("blue", length(levels(resultados_viento$MES))),
breaks = levels(resultados_viento$MES),
labels = c("enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre")) +
theme_minimal()
