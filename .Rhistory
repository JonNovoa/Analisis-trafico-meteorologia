# Cargar los datos desde el archivo CSV
accidentes <- read.csv("C:/Users/somor/OneDrive/Escritorio/ProyR/datosUnidos.csv", header = TRUE, sep = ";")
# Convertir la columna HUMEDAD_RELATIVA a numérica (asegurándote de que esté en el formato correcto)
accidentes$HUMEDAD_RELATIVA <- as.numeric(accidentes$HUMEDAD_RELATIVA)
# Contar el número de accidentes por mes y humedad relativa
accidentes_contados <- accidentes %>%
group_by(MES, HUMEDAD_RELATIVA) %>%
summarise(Num_Accidentes = n_distinct(num_expediente))
# Crear la gráfica de barras
ggplot(accidentes_contados, aes(x = HUMEDAD_RELATIVA, y = Num_Accidentes, fill = factor(MES))) +
geom_bar(stat = "identity", position = "dodge") +
labs(title = "Número de Accidentes según Humedad Relativa por Mes",
x = "Humedad Relativa",
y = "Número de Accidentes") +
scale_fill_discrete(name = "Mes") +
theme_minimal()
