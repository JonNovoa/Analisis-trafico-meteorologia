source("C:/Users/somor/OneDrive/Escritorio/ProyR/graficos2.R")
data <- read.csv("C:/Users/somor/OneDrive/Escritorio/ProyR/datosUnidos.csv", header = TRUE, sep = ";")
data$PRECIPITACION <- as.numeric(gsub(",", ".", data$PRECIPITACION))
# Crear la gráfica de dispersión con línea de tendencia
